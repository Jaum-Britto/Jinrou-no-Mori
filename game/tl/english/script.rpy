    "Is it just me or is my stomach getting louder and louder?"

# game/script.rpy:175
translate english day_1_ba5ab9d8:
    # "Apollo me encara por um momento antes de soltar uma risada suave..."
    "Apollo stares at me for a moment before letting out a soft laugh..."

# game/script.rpy:184
translate english day_1_e801bda8:
    # ap "bem, eu trabalho aqui."
    ap "Well, I work here."

# game/script.rpy:185
