    "This is weird..."

# game/script.rpy:149
translate english day_1_c210133b:
    # "Ele me contou?"
    "Did he tell me?"

# game/script.rpy:150
translate english day_1_7cfe4e5a:
    # "Eu olho para ele..."
    "I look at him..."

# game/script.rpy:151
translate english day_1_b5d9c78d:
    # "O olhar confiante e presunçoso se transforma em incerteza..."
    "His confident, smug look turns into uncertainty..."

# game/script.rpy:152
translate english day_1_9a9a7524:
    # ap "Quer dizer..."
    ap "I mean..."

# game/script.rpy:153
translate english day_1_c6a7e2b5:
    # ap "Eu queria te contar..."
    ap "I wanted to tell you..."

# game/script.rpy:154
