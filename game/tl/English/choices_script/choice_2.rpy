# game/choices_script/choice_2.rpy:5
translate English Left_ee75843e:

    # "Aiiiii...."
    "Aiiiii...."

# game/choices_script/choice_2.rpy:6
translate English Left_5477deab:

    # "Abro os olhos rapidamente pedindo desculpas à pessoa à minha frente."
    "I open my eyes quickly apologizing to the person in front of me."

# game/choices_script/choice_2.rpy:7
translate English Left_d0971174:

    # mc "desculpe! eu não vi-"
    mc "sorry! I didn't see-"

# game/choices_script/choice_2.rpy:8
translate English Left_51db8f4a:

    # "É o cara que apareceu antes!"
    "It's the guy who showed up earlier!"

# game/choices_script/choice_2.rpy:9
translate English Left_a2a5e3e1:

    # "Ele não faz ou diz nada por um segundo...Um segundo muito longo."
    "He doesn't do or say anything for a second...A very long second."

# game/choices_script/choice_2.rpy:10
translate English Left_7932cc87:

    # "Ele quase parece em choque."
    "He almost looks in shock."

# game/choices_script/choice_2.rpy:11
translate English Left_de421517:

    # mc "hm...você...?"
    mc "hm...you...?"

# game/choices_script/choice_2.rpy:12
translate English Left_9dbe6b37:

    # s "ah...uh...desculpe...também..."
    s "ah...uh...sorry...also..."

# game/choices_script/choice_2.rpy:13
translate English Left_02948cd0:

    # "Ele tenta manter contato visual, mas parece evitar meus olhos em cada palavra que sai de sua boca."
    "He tries to maintain eye contact, but seems to avoid my eyes with every word that comes out of his mouth."

# game/choices_script/choice_2.rpy:14
translate English Left_251447af:

    # "Dou um sorriso estranho de “com licença” e passo por ele. Eu o sinto olhando para mim por cima do ombro."
    "I give a strange “excuse me” smile and walk past him. I feel him looking at me over his shoulder."

# game/choices_script/choice_2.rpy:15
translate English Left_89aaad8a:

    # "Isso foi estranho..."
    "That was weird..."

